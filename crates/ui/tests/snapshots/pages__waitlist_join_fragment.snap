---
source: crates/ui/tests/pages.rs
expression: reply.body
---
<form class="cf-form" data-cf-module="waitlist" data-cf-action="join" method="post" action="/ui/waitlist/join" novalidate><div class="cf-field" data-cf-field="email"><label class="cf-label" for="cf-waitlist-join-email">Email<span class="cf-required" aria-hidden="true">*</span></label><input class="cf-input" type="email" id="cf-waitlist-join-email" name="email" required placeholder="you@example.com" autocomplete="email"></div><div class="cf-field" data-cf-field="product"><label class="cf-label" for="cf-waitlist-join-product">Product<span class="cf-required" aria-hidden="true">*</span></label><select class="cf-input cf-input--select" id="cf-waitlist-join-product" name="product" required><option value="">Choose</option><option value="kontinuum">Kontinuum</option><option value="undercover">Undercover</option></select></div><input type="hidden" name="ref" value="R1"><div class="cf-field cf-field--captcha" data-cf-field="captchaToken"><div class="cf-turnstile" data-sitekey="0x4AAAAAAA-site"></div></div><div class="cf-actions"><button class="cf-submit" type="submit">Join</button></div></form>
