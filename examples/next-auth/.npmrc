# Install the `file:../../packages/auth-ts` dependency by packing and copying it
# into node_modules, rather than symlinking it. A symlink would leave
# `node_modules/@cratefield/auth/dist/next.js` resolving `next/headers` from
# `packages/auth-ts`'s real path, where no `next` is installed. Copying keeps the
# package inside this app's node_modules tree so that import resolves.
install-links=true
