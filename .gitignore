target/
build/
.wrangler/
.dev.vars
*.log
.DS_Store
PROGRESS.md

# Agent scratch that belongs in the worktree, never in the repo. BRIEF.md
# reached main once, in #250. The other guard is the `package` CI job's
# deny-list (tools/package-check.sh), and that one only catches a
# *BRIEF.md or PROGRESS.md that would ship inside a published crate.
/BRIEF.md
/BUILD-BRIEF.md
/*-BRIEF.md
node_modules/

# Local worktrees. `git add -A` otherwise stages one as a gitlink.
.worktrees/

# The dev server's generated development KEK. `git add -A` otherwise stages
# key material into the repository, which is the one mistake in this area
# that cannot be walked back.
/control-plane-dev.kek
*.kek

# Credential stores and local-tool config. `git add -A` otherwise stages
# them; the filename is the whole warning, so an empty one must be ignored
# too. Root-anchored: examples/next-auth/.npmrc is a tracked template.
/.env
/.env.*
/.netrc
/.git-credentials
/.npmrc
/.pypirc
/.envrc
/.mcp.json
/.gitmodules
