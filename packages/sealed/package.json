{
  "name": "@cratefield/sealed",
  "version": "0.1.0",
  "description": "Browser-side envelope crypto for the Cratefield sealed-blob store: AES-256-GCM payloads whose content key is wrapped once per unlock (passkey PRF or Argon2id recovery code).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cratefield/harness",
    "directory": "packages/sealed"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  }
}
