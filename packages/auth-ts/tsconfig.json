{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // `WebWorker` gives the WebCrypto, Fetch and URL globals without pulling
    // in the Node lib: `"types": []` below stops `@types/node` (if it ever
    // appears in the tree) from leaking in, so a `node:` import or `Buffer`
    // in src/ fails to compile rather than shipping a Node-only entry point.
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
